{
  "name": "gym-training-companion",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["apps/mobile", "packages/training-engine", "packages/uri-decoder-compat"],
  "engines": { "node": ">=22.13.0 <23 || >=24.3.0" },
  "overrides": {
    "react": "19.2.3", "react-dom": "19.2.3",
    "react-native-worklets": "0.10.1", "react-native-reanimated": "4.5.1",
    "react-native-gesture-handler": "~2.32.0",
    "query-string@7.1.3": {
      "decode-uri-component": "0.5.0"
    },
    "xcode@3.0.1": { "uuid": "11.1.1" }
  },
  "scripts": {
    "start": "node scripts/mobile.mjs start --go",
    "start:tunnel": "node scripts/mobile.mjs start --go --tunnel",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc --noEmit -p tsconfig.tests.json",
    "lint": "eslint apps/mobile/src packages scripts tests",
    "test": "tsx --test tests/*.test.ts packages/training-engine/*.test.ts",
    "export:ios": "node scripts/mobile.mjs export --platform ios",
    "doctor": "npm exec --workspace apps/mobile -- expo-doctor",
    "check:supabase": "node scripts/check-supabase.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.0",
    "tsx": "^4.20.0",
    "typescript": "~6.0.3"
  }
}
